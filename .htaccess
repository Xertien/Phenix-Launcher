RewriteEngine On
RewriteRule ^(launcher/news-launcher/config.ini) - [F,L,NC]

Options -Indexes

RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^files/php(/|$) - [F,L,NC]
RewriteRule ^files/instances/.*\.(php[0-9]?|phtml|phar)$ - [F,L,NC]
RewriteCond %{REQUEST_URI} !^/?files/instances/ [NC]
RewriteRule \.(ini|log|env|bak|old|orig|swp|sql|sqlite|db|conf|dist|yml|yaml|lock)$ - [F,L,NC]
RewriteRule ^(README\.md|LICENSE(\.md)?|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
</IfModule>
