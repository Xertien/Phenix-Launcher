{
    "name": "Phenix-Launcher",
    "preductname": "Phénix Launcher",
    "version": "3.0.12",
    "description": "Phénix moddé v3 launcher",
    "main": "src/app.js",
    "author": {
        "name": "Xertien",
        "email": "contact@ptaki.dev",
        "url": "https://github.com/Xertien"
    },
    "url": "https://launchermodded.phe-go.com",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "start-menu-test": "electron .",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
        "build": "node build.js --obf=true --build=platform",
        "icon": "node build.js --icon=https://raw.githubusercontent.com/Xertien/Phenix-Launcher/refs/heads/master/src/assets/images/icon.png"
    },
    "license": "CCANC",
    "engines": {
        "node": ">=22.12.0"
    },
    "nodemonConfig": {
        "ext": "js,html,css",
        "ignore": "**/test"
    },
    "dependencies": {
        "@sentry/electron": "^7.20.0",
        "electron-updater": "^6.8.9",
        "minecraft-java-core": "^3.11.4",
        "node-bdd": "^2.0.4",
        "node-fetch": "^2.7.0",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "@electron/fuses": "^2.1.3",
        "cross-env": "^10.1.0",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "javascript-obfuscator": "^5.8.0",
        "jimp": "^0.22.12",
        "nodemon": "^3.1.14",
        "png2icons": "^2.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Xertien/Phenix-Launcher.git"
    }
